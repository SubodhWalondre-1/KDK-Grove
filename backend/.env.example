# Core Settings
DATABASE_URL=sqlite:///./mediora.db
UPLOAD_DIR=./uploads
JWT_SECRET_KEY=change_me_to_a_secure_random_key_in_production
JWT_EXPIRY_MINUTES=1440

# Admin
ADMIN_API_KEY=change_me_to_a_long_random_string

# F1 / F4 — OCR & Extraction LLM
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
GROQ_API_KEY=your_groq_api_key
QWEN_MODEL_SLUG=qwen/qwen3-8b-instruct

# F3 — Translation
SARVAM_API_KEY=your_sarvam_ai_api_key
SARVAM_BASE_URL=https://api.sarvam.ai/translate

# F5 / F8 — Reasoning LLM & Recommendations
GEMINI_API_KEY=your_gemini_api_key
RECOMMENDATION_MODEL_SLUG=google/gemini-2.5-flash
